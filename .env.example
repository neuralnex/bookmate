# Server
PORT=3000
NODE_ENV=development

# Database (required — no fallback in application code)
DATABASE_URL=postgresql://localhost:5432/bookmate
# Docker Compose api service uses hostname `postgres` on the compose network — match postgres service POSTGRES_* (see compose files).
# DATABASE_URL=postgresql://bookmate_user:bookmate_password@postgres:5432/bookmate
# DATABASE_SSL=true

# JWT (required — no fallback secret in application code)
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# -----------------------------------------------------------------------------
# Initial admin — `npm run create-admin` uses these when you run it with no CLI args.
# regNumber must be exactly 11 digits. Do not commit real passwords; use strong values in `.env` only.
# -----------------------------------------------------------------------------
ADMIN_NAME=Admin User
ADMIN_EMAIL=admin@example.com
ADMIN_REG_NUMBER=20210000001
ADMIN_PASSWORD=change-me-strong-password

# CORS (browser clients)
CORS_ORIGIN=http://localhost:3000

# OpenAPI docs server URL override (optional)
# API_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Monnify (payments) — all required for payment routes; set in .env only (not in code).
# Dashboard: https://www.monnify.com
# -----------------------------------------------------------------------------
MONNIFY_API_KEY=your-api-key
MONNIFY_SECRET_KEY=your-secret-key
MONNIFY_CONTRACT_CODE=your-contract-code
# Sandbox: https://sandbox.monnify.com | Production: https://api.monnify.com
MONNIFY_BASE_URL=https://sandbox.monnify.com
# Full HTTPS URL whose *origin* is used for mobile checkout bounce-back (see PUBLIC_WEB_* below).
# Also the fallback redirectUrl passed to Monnify when no dynamic URL is computed.
MONNIFY_RETURN_URL=http://localhost:3000/payments/return
# Webhook or manual verification hits this route; configure this URL in the Monnify dashboard if offered.
MONNIFY_CALLBACK_URL=http://localhost:3000/payments/callback

# OPTIONAL: public API origin only (no path), e.g. https://your-app.onrender.com — overrides deriving origin from MONNIFY_RETURN_URL
# PUBLIC_WEB_BASE_URL=https://your-app.onrender.com

# Expo / native scheme in app.json (used by GET /payments/mobile-return → fubooks://orders/...)
APP_DEEP_LINK_SCHEME=fubooks

# Mobile app (Expo): copy mobile/.env.example → mobile/.env and set:
# EXPO_PUBLIC_API_URL=http://localhost:3000
